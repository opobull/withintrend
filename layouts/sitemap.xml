{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
    {{- if not .Params.private }}
    {{- $lastmod := (default .Date .Lastmod) }}
    {{- $daysSinceMod := div (sub now.Unix $lastmod.Unix) 86400 }}
    {{- $priority := "0.5" }}
    {{- if eq .Kind "home" }}{{ $priority = "1.0" }}
    {{- else if and (eq .Kind "page") (lt $daysSinceMod 30) }}{{ $priority = "0.9" }}
    {{- else if and (eq .Kind "page") (lt $daysSinceMod 90) }}{{ $priority = "0.7" }}
    {{- else if eq .Kind "section" }}{{ $priority = "0.6" }}
    {{- else if eq .Kind "taxonomy" }}{{ $priority = "0.5" }}
    {{- else if eq .Kind "term" }}{{ $priority = "0.4" }}
    {{- end }}
    {{- $changefreq := "monthly" }}
    {{- if lt $daysSinceMod 7 }}{{ $changefreq = "weekly" }}
    {{- else if lt $daysSinceMod 30 }}{{ $changefreq = "weekly" }}
    {{- else if lt $daysSinceMod 180 }}{{ $changefreq = "monthly" }}
    {{- else }}{{ $changefreq = "yearly" }}
    {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
    {{ with .Translations }}
    {{- range . }}
    <xhtml:link
      rel="alternate"
      hreflang="{{ .Lang }}"
      href="{{ .Permalink }}"
    />
    {{- end }}
    {{- end }}
  </url>
    {{- end }}
  {{ end }}
</urlset>
